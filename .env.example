# Only devnet and mainnet-beta are accepted. Start with devnet.
SKILLSEAL_CLUSTER=devnet

# Replace with absolute deployment paths. Never place these values in model input.
SKILLSEAL_DATA_DIR=/absolute/path/to/skillseal/.skillseal-data
SKILLSEAL_APPROVED_DIR=/absolute/path/to/skillseal/approved-skills

# Optional. Public Solana RPC is used when omitted. Never expose an API-key URL
# in a public recording or committed file.
SKILLSEAL_RPC_DEVNET=https://api.devnet.solana.com
SKILLSEAL_RPC_MAINNET_BETA=https://api.mainnet-beta.solana.com

# Absolute path to the local ZeroClaw binary used for native Skill audit.
SKILLSEAL_ZEROCLAW_BIN=/absolute/path/to/zeroclaw

# Comma-separated publisher public keys. Empty by default, so unknown
# publishers become REVIEW_BLOCKED. These are public addresses, never keypairs.
SKILLSEAL_TRUSTED_AUTHORITIES=
