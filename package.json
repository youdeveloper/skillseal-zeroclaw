{
  "name": "skillseal",
  "version": "0.1.0",
  "private": true,
  "description": "A fail-closed installation firewall for Gitlana on-chain skills used by ZeroClaw.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap:tools": "node scripts/bootstrap-tools.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test",
    "release:candidate": "npm run build && node scripts/build-release-candidate.mjs",
    "release:devnet": "npm run build && node scripts/devnet-release.mjs"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@noble/hashes": "^1.8.0",
    "better-sqlite3": "^12.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "20.19.18",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "license": "Apache-2.0"
}
